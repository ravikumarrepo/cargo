# Cargo Admin Configuration
# Copy this to .env and set values for your deployment

# Admin account credentials (set during initial setup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<choose-a-strong-password>

# Flask configuration
# The app reads SECRET_KEY (not FLASK_SECRET_KEY)
SECRET_KEY=<run: python -c "import secrets; print(secrets.token_hex(32))">
FLASK_DEBUG=False

# Database
# Neon example: postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=sqlite:///cargo.db

# Database connection pool (PostgreSQL only — defaults shown)
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=5
# DB_POOL_RECYCLE=280
# DB_CONNECT_TIMEOUT=15

# Session configuration
SESSION_TIMEOUT=900
REFRESH_TOKEN_EXPIRY=604800

# Logging
LOG_LEVEL=INFO
